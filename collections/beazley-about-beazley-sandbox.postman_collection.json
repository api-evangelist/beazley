      "request": {
        "name": "people",
        "description": {
          "content": "<p>The base URL returns the collection of all Beazley people profiles. Individual people profiles can be returned by including the resource ID in the URL.\n</p>\nFor example:<br>\n<b>/people</b> returns the full collection set.<br>\n<b>/people/1</b> returns the individual person record.<br>",
          "type": "text/plain"
        },
        "url": {
          "path": [
            "people"
          ],
          "host": [
            "{{baseUrl}}"
          ],
          "query": [
            {
              "disabled": false,
              "key": "division",
              "value": "<string>",
              "description": "Gets an array of people filtered by the specified division ID"
            },
            {
              "disabled": false,
              "key": "firstNameFragment",
              "value": "<string>",
              "description": "Gets an array of people whose first name contains the specified fragment"
            },
            {
              "disabled": false,
              "key": "lastNameFragment",
              "value": "<string>",
              "description": "Gets an array of people whose last name contains the specified fragment"
            },
            {
              "disabled": false,
              "key": "since",
              "value": "<string>",
              "description": "Gets an array of people updated since a date/time (format ISO 8601)"
            },
            {
              "disabled": false,
              "key": "key",
              "value": "<string>"
            }
          ],
          "variable": []
        },
